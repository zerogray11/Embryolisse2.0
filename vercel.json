{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/products/(.*)",
      "dest": "https://embryolisse-backend-103c79c8a16d.herokuapp.com/api/products/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://embryolisse-python-5ce7c3101a2a.herokuapp.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}